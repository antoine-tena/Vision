# Fins de ligne normalisées en LF dans le dépôt, quel que soit le poste (Windows compris).
* text=auto eol=lf

# Binaires.
*.png binary
*.jpg binary
*.ico binary
*.npz binary

# Fichiers générés, exemptés de [TAILLE-FICHIER] (CLAUDE.md).
backend/uv.lock linguist-generated=true
frontend/uv.lock linguist-generated=true
# Modèles entraînés : régénérés par leur commande d'entraînement (data/README.md).
backend/data/models/** linguist-generated=true
