{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PROJET_NOM": "vision",
    "PROJET_BACK": "backend",
    "PROJET_FRONT": "frontend",
    "PROJET_ENV_TEST": ""
  },
  "extraKnownMarketplaces": {
    "kiln": {
      "source": {
        "source": "github",
        "repo": "antoine-tena/kiln"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "base@kiln": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
